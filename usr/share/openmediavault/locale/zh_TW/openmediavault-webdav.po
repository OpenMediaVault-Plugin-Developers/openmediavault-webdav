msgid "Enable"
msgstr "啟用"

msgid "Extra options"
msgstr "額外選項"

msgid "Folder name or path after the domain (e.g., /webdav)."
msgstr "檔案夾名稱或網域名稱之後的路徑(例如：/webdav)。"

msgid "Group"
msgstr "群組"

msgid "Isolate each user into their own WebDAV directory."
msgstr "將每位用户隔離在他們自己的 WebDAV 目錄裏。"

msgid "Path"
msgstr "路徑"

msgid "Select a group ..."
msgstr "選擇一個群組 ..."

msgid "Shared folder"
msgstr "共享檔案夾"

msgid "Shared folder must not be 'None' to enable webdav"
msgstr "若要啟用 webdav，共享檔案夾必須不是 'None'。"

msgid "This option specifies the group that has access."
msgstr "此選項指定有存取權限的群組。"

msgid "Updated WebDAV settings."
msgstr "已更新 WebDAV 設定。"

msgid "Use auth"
msgstr "使用驗證"

msgid "User isolation"
msgstr "用户隔離"

msgid "WebDAV"
msgstr "WebDAV"

msgid ""
"extra nginx config lines<br/>Must be valid for the nginx location context"
msgstr "額外的 nginx 設置列<br/>必須在 nginx location 的境況中是合用的。"
