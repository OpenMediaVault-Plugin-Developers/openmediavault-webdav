msgid "Enable"
msgstr "ເປີດໃຊ້ງານ"

msgid "Extra options"
msgstr "ຕົວເລືອກເພີ່ມເຕີມ"

msgid "Folder name or path after the domain (e.g., /webdav)."
msgstr "ຊື່ໂຟນເດີ ຫຼື ເສັ້ນທາງຫຼັງຈາກໂດເມນ (ຕົວຢ່າງ: /webdav)."

msgid "Group"
msgstr "ກຸ່ມ"

msgid "Isolate each user into their own WebDAV directory."
msgstr "ແຍກຜູ້ໃຊ້ແຕ່ລະຄົນໄວ້ໃນໄດເຣັກທໍຣີ WebDAV ຂອງໃຜລາວ."

msgid "Path"
msgstr "ເສັ້ນທາງ"

msgid "Select a group ..."
msgstr "ເລືອກກຸ່ມ ..."

msgid "Shared folder"
msgstr "ໂຟນເດີທີ່ແບ່ງປັນ"

msgid "Shared folder must not be 'None' to enable webdav"
msgstr "ໂຟນເດີທີ່ແບ່ງປັນຕ້ອງບໍ່ແມ່ນ 'None' ເພື່ອເປີດໃຊ້ງານ webdav"

msgid "This option specifies the group that has access."
msgstr "ຕົວເລືອກນີ້ລະບຸກຸ່ມທີ່ມີສິດເຂົ້າເຖິງ."

msgid "Updated WebDAV settings."
msgstr "ອັບເດດການຕັ້ງຄ່າ WebDAV ແລ້ວ."

msgid "Use auth"
msgstr "ໃຊ້ການຢືນຢັນຕົວຕົນ"

msgid "User isolation"
msgstr "ການແຍກຜູ້ໃຊ້"

msgid "WebDAV"
msgstr "WebDAV"

msgid ""
"extra nginx config lines<br/>Must be valid for the nginx location context"
msgstr "ບັນທັດການຕັ້ງຄ່າ nginx ເພີ່ມເຕີມ<br/>ຕ້ອງຖືກຕ້ອງຕາມບໍລິບົດຂອງ nginx location"
